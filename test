# PARAMETERS CELL ********************



# destination
destination_schema   = ""              # source system name, created if missing
destination_table    = ""
load_type            = "incremental_merge"   # full_reload | incremental_merge | incremental_window
start_date           = "2020-01-01"
end_date             = ""
 
# incremental watermark
source_watermark_column = ""           # bronze column holding the high water mark, blank = load_timestamp
watermark_format        = ""           # optional parse format when that column is a string, e.g. yyyy-MM-dd
watermark_offset_days   = 0            # re-read this many days before the watermark, for late arriving data
 
# idempotency
batch_id             = ""              # REQUIRED from the pipeline: @pipeline().RunId
primary_key          = ""              # comma-separated source columns; required by incremental_merge
 
# load_type names a complete valid combination of read window and write
# behaviour, so invalid states cannot be expressed:
#
#   full_reload         fetch everything from start_date, replace the table.
#                       The only safe mode when the watermark is mutable and
#                       there is no business key.
#   incremental_merge   fetch from the watermark, upsert on primary_key.
#                       Safe whether or not the watermark changes on update.
#   incremental_window  fetch from the watermark, replace that date range
#                       whole. Requires an IMMUTABLE watermark - choosing
#                       this mode is that assertion. No key needed.
 
# auth
auth_type                            = "none"   # none | api_key | oauth2_client_credentials
azure_key_vault                      = ""
azure_key_vault_secret_token_name    = ""
azure_key_vault_secret_client_id_name = ""
azure_key_vault_secret_client_secret_name = ""
azure_key_vault_secret_api_audience_name  = ""
azure_key_vault_secret_api_scope_name     = ""
token_url                            = ""
 
# source
source_connection_base_url    = ""
source_connection_url_endpoint = ""
query_params   = "{}"
extra_headers  = "{}"
date_param_from = ""
date_param_to   = ""
 
# response
response_format = "json"               # json | csv
records_path    = ""
pagination      = "none"               # none | next_link | cursor
cursor_param    = "cursor"
cursor_field    = "nextCursor"
page_size_param = ""
page_size       = 1000
max_pages       = 100
request_delay   = 0                    # seconds between requests, for rate limited APIs
 
# pagination safety
fail_on_page_cap = True                # raise instead of writing a truncated dataset
sort_param       = ""                  # e.g. "orderBy" or "sort", if the API supports it
sort_ascending   = ""                  # the value for sort_param, e.g. "createdAt asc"
 
# retry tunables, per source
max_attempts    = 5
connect_timeout = 10
read_timeout    = 120                  # seconds BETWEEN bytes, not total request duration
base_delay      = 1.0
max_delay       = 60.0
